# =============================================================================
# SquadAI Harness - Template de Variáveis de Ambiente (Enterprise Ready)
# Instruções: Copie este arquivo para `.env` e configure conforme sua organização.
# ATENÇÃO: NUNCA comite arquivos `.env` com valores reais.
# =============================================================================

# --- GOVERNANÇA E AMBIENTE CORPORATIVO ---
# Ambiente de execução: development | staging | enterprise | production
SQUAD_ENV=enterprise

# Ativa política de rede restrita (apenas tráfego homologado e proxy)
RESTRICTED_NETWORK=1

# Trilha de auditoria para conformidade BACEN / LGPD / PCI-DSS (0 = desativado, 1 = ativo)
SQUAD_AUDIT_LOG=1

# Nível de logging da aplicação: DEBUG | INFO | WARNING | ERROR | CRITICAL
LOG_LEVEL=INFO


# --- PROXY CORPORATIVO E CERTIFICADOS SSL (SE APLICÁVEL) ---
# Descomente e preencha se sua empresa utiliza proxy ou inspeção SSL (ex: Zscaler, Fortinet)
# HTTP_PROXY=http://proxy.empresa.corp:8080
# HTTPS_PROXY=http://proxy.empresa.corp:8080
# NO_PROXY=localhost,127.0.0.1,.empresa.corp

# Caminho para o certificado raiz corporativo (CA Bundle)
# REQUESTS_CA_BUNDLE=C:\caminho\para\corporate-ca.pem
# SSL_CERT_FILE=C:\caminho\para\corporate-ca.pem
# NODE_EXTRA_CA_CERTS=C:\caminho\para\corporate-ca.pem


# --- PROVEDORES DE MODELOS LLM (AI ENGINES) ---
ENABLE_AI_ENGINE=True

# Anthropic Claude API Key (ou via AWS Bedrock abaixo)
ANTHROPIC_API_KEY=

# Google Gemini API Key
GEMINI_API_KEY=


# --- AWS & NUVEM (BEDROCK / ECS / LAMBDA / DYNAMODB) ---
AWS_DEFAULT_REGION=us-east-1

# Para desenvolvimento local 100% offline (Air-Gapped / LocalStack):
# Deixe preenchido com http://localhost:4566 ou vazio para AWS real na nuvem
AWS_ENDPOINT_URL=

# Credenciais IAM (preferir AWS IAM Identity Center / SSO na empresa):
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
# AWS_SESSION_TOKEN=


# --- BANCO DE DADOS & ARMAZENAMENTO LOCAL ---
# Caminho para sqlite local do kanban/memória (opcional)
# SQUAD_DB_PATH=./data/squad.db
