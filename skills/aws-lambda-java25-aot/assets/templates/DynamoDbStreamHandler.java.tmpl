    private void on{{ filter_type }}Insert(Map<String, AttributeValue> img) {
        // TODO: lógica downstream — publicar EventBridge, atualizar cache, etc.
    }

    private void on{{ filter_type }}Modify(Map<String, AttributeValue> oldImg, Map<String, AttributeValue> newImg) {
        // TODO: lógica de update — diff, fan-out, etc.
    }

    private void on{{ filter_type }}Remove(Map<String, AttributeValue> oldImg) {
        // TODO: lógica de remoção — limpar cache, soft-delete downstream.
    }

{{/each}}

    // ─── Roteamento por _type ───────────────────────────────────────────

    private void onInsert(String type, Map<String, AttributeValue> img) {
        switch (type) {
{{#each stream_handlers}}
            case "{{ filter_type }}" -> on{{ filter_type }}Insert(img);
{{/each}}
            default -> { /* ignore */ }
        }
    }

    private void onModify(String type, Map<String, AttributeValue> oldImg, Map<String, AttributeValue> newImg) {
        switch (type) {
{{#each stream_handlers}}
            case "{{ filter_type }}" -> on{{ filter_type }}Modify(oldImg, newImg);
{{/each}}
            default -> { /* ignore */ }
        }
    }

    private void onRemove(String type, Map<String, AttributeValue> oldImg) {
        switch (type) {
{{#each stream_handlers}}
            case "{{ filter_type }}" -> on{{ filter_type }}Remove(oldImg);
{{/each}}
            default -> { /* ignore */ }
        }
    }

    private String extractType(Map<String, AttributeValue> newImage, Map<String, AttributeValue> oldImage) {
        Map<String, AttributeValue> source = newImage != null ? newImage : oldImage;
        if (source != null && source.containsKey("_type")) {
            return source.get("_type").getS();
        }
        return "UNKNOWN";
    }
}
