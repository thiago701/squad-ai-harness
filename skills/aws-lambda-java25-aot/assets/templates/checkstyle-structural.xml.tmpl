<?xml version="1.0"?>
<!DOCTYPE module PUBLIC
  "-//Checkstyle//DTD Checkstyle Configuration 1.3//EN"
  "https://checkstyle.org/dtds/configuration_1_3.dtd">
<!--
  Structural Object Calisthenics gate. Goes to config/checkstyle/checkstyle.xml.

  Deliberately NARROW: only the design-metric modules that map to Object
  Calisthenics structural rules — method size, parameter count, cyclomatic /
  boolean complexity, class size, one statement per line. No style, Javadoc,
  naming, import or whitespace noise: those produce churn, not signal.

  Thresholds are calibrated to clean hexagonal code so the gate passes on a
  healthy project and its job is to catch FUTURE structural regressions. Where a
  threshold is looser than canonical Object Calisthenics (e.g. ParameterNumber 5
  vs 3), it accommodates justified factory/reconstitution methods; suppress those
  narrowly in suppressions.xml rather than raising the global bar. Architectural
  OC rules (thin handler, domain decoupled from AWS/infra, DTOs out of the domain,
  repositories in infrastructure) belong in the ArchUnit suite, not here.
-->
<module name="Checker">
  <property name="severity" value="error"/>
  <property name="fileExtensions" value="java"/>

  <!-- OC: keep classes small -->
  <module name="FileLength">
    <property name="max" value="300"/>
  </module>

  <module name="TreeWalker">
    <!-- OC: short methods (constructors are wiring seams, excluded) -->
    <module name="MethodLength">
      <property name="tokens" value="METHOD_DEF"/>
      <property name="max" value="35"/>
      <property name="countEmpty" value="false"/>
    </module>

    <!-- OC: behaviour methods stay narrow; constructors excluded so a
         composition root is not penalised -->
    <module name="ParameterNumber">
      <property name="tokens" value="METHOD_DEF"/>
      <property name="max" value="5"/>
    </module>

    <!-- OC: avoid accidental complexity / deep nesting -->
    <module name="CyclomaticComplexity">
      <property name="max" value="12"/>
    </module>
    <module name="BooleanExpressionComplexity">
      <property name="max" value="4"/>
    </module>

    <!-- OC: one statement per line -->
    <module name="OneStatementPerLine"/>
  </module>
</module>
