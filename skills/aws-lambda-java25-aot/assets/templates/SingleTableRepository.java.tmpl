/**
 * Repository para o single-table {{ single_table_name }}.
 *
 * Cada método cobre 1 access pattern. Adicione novos métodos conforme novas
 * queries surgirem — não use 'queryByExample' genérico, single-table exige
 * intencionalidade em cada query (PK/SK ou GSI).
 */
@Repository
public class SingleTableRepository {

    private final DynamoDbTable<SingleTableItem> table;

    public SingleTableRepository(DynamoDbTable<SingleTableItem> table) {
        this.table = table;
    }

{{#each entities}}
    // ─── {{ name }} ─────────────────────────────────────────────────────

    public Optional<{{ name }}> get{{ name }}(String id) {
        SingleTableItem item = table.getItem(Key.builder()
            .partitionValue("{{ type_discriminator }}#" + id)
            .sortValue("{{ type_discriminator }}#" + id)
            .build());
        return Optional.ofNullable(item).map({{ name }}::fromItem);
    }

    public void save{{ name }}({{ name }} entity) {
        table.putItem(entity.toItem());
    }

    public void delete{{ name }}(String id) {
        table.deleteItem(Key.builder()
            .partitionValue("{{ type_discriminator }}#" + id)
            .sortValue("{{ type_discriminator }}#" + id)
            .build());
    }

{{/each}}
}
