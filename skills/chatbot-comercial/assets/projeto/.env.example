# --- identidade do tenant -------------------------------------------------
CHATBOT_TENANT={{TENANT}}
CHATBOT_VERTICAL={{VERTICAL}}
CHATBOT_ESTABELECIMENTO={{ESTABELECIMENTO}}
CHATBOT_CANAIS={{CANAIS}}
CHATBOT_PORTA=8080

# --- retrieval ------------------------------------------------------------
CHATBOT_TOP_K=3
CHATBOT_SCORE_MINIMO=0.30

# --- custo (restrição 3): teto por conversa e por mês ----------------------
CHATBOT_TETO_CONVERSA_BRL=0.50
CHATBOT_TETO_MES_BRL=150.0

# --- LGPD (restrição 5 / M5) ----------------------------------------------
CHATBOT_RETENCAO_DIAS=180
CHATBOT_EXIGIR_CONSENTIMENTO=0
CHATBOT_SAL_HASH=troque-este-sal-por-tenant

# --- llm-gateway ----------------------------------------------------------
# 0 = modo extrativo real (responde citando a fonte, custo zero, sem rede).
# 1 = usa o pacote llm-gateway. Roteamento, cache e limite de custo são DELE.
LLM_GATEWAY_ATIVO=0
LLM_GATEWAY_MODELO=rapido
LLM_GATEWAY_TIMEOUT_S=8.0
LLM_GATEWAY_TENTATIVAS=2

# --- canais ---------------------------------------------------------------
WHATSAPP_APP_SECRET=
WHATSAPP_VERIFY_TOKEN=
WHATSAPP_VERIFICAR_ASSINATURA=1

# --- painel do atendente --------------------------------------------------
# Vazio = painel aberto (só para dev local). Em produção, defina.
PAINEL_TOKEN=
